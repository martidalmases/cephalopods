[Unit]
Description=Recolector de datos del Mediterráneo (NASA Giovanni + NOAA ERDDAP)
After=network-online.target

[Service]
Type=oneshot
User=cephalopods
WorkingDirectory=/opt/cephalopods
EnvironmentFile=/etc/cephalopods.env
ExecStart=/opt/cephalopods/.venv/bin/python recolector.py
TimeoutStartSec=6h
